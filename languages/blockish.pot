msgstr ""

#: includes/Config/BlocksList.php:33
msgid ""
"The primary layout and structure block. Use it to build hero sections, "
"feature grids, card rows, full-width banners, or any section wrapper. "
"Supports both flexbox and CSS grid layouts with full background, border, "
"and shadow styling including hover states. Any HTML semantic tag can be "
"used (div, section, article, etc.)."
msgstr ""

#: includes/Config/BlocksList.php:38
msgid "Icon"
msgstr ""

#: includes/Config/BlocksList.php:39
msgid ""
"Displays a single SVG icon with color, size, rotation, and an optional "
"link. Use for decorative accents, feature highlights, or standalone icon "
"links."
msgstr ""

#: includes/Config/BlocksList.php:44
msgid "Heading"
msgstr ""

#: includes/Config/BlocksList.php:45
msgid ""
"A heading block (H1?H6) with per-device text alignment, typography, color, "
"hover color, and text shadow. Use for page titles, section headings, and "
"card labels when custom styling beyond the core heading is needed."
msgstr ""

#: includes/Config/BlocksList.php:50
msgid "Post Title"
msgstr ""

#: includes/Config/BlocksList.php:51
msgid ""
"Displays the current post title with an optional permalink, semantic "
"heading tag, responsive alignment, typography, color, and text shadow "
"controls."
msgstr ""

#: includes/Config/BlocksList.php:56
msgid "Post Excerpt"
msgstr ""

#: includes/Config/BlocksList.php:57
msgid ""
"Displays the current post excerpt with configurable length, optional "
"read-more link, responsive alignment, typography, and colors."
msgstr ""

#: includes/Config/BlocksList.php:62
msgid "Post Featured Image"
msgstr ""

#: includes/Config/BlocksList.php:63
msgid ""
"Displays the current post featured image with image sizing, optional "
"permalink, responsive dimensions, border, and shadow controls."
msgstr ""

#: includes/Config/BlocksList.php:68
msgid "Post Content"
msgstr ""

#: includes/Config/BlocksList.php:69
msgid ""
"Displays the current post content with semantic wrapper, responsive "
"alignment, typography, and color controls."
msgstr ""

#: includes/Config/BlocksList.php:74
msgid "Post Info"
msgstr ""

#: includes/Config/BlocksList.php:75
msgid ""
"Displays post metadata such as author, published/modified dates, time, "
"comments, and terms with icons, separators, and optional links."
msgstr ""

#: includes/Config/BlocksList.php:80
msgid "Site Title"
msgstr ""

#: includes/Config/BlocksList.php:81
msgid ""
"Displays the site title with an optional home link, semantic heading tag, "
"responsive alignment, typography, color, and text shadow controls."
msgstr ""

#: includes/Config/BlocksList.php:86
msgid "Site Tagline"
msgstr ""

#: includes/Config/BlocksList.php:87
msgid ""
"Displays the site tagline (description) with a semantic HTML tag, "
"responsive alignment, typography, color, and text shadow controls."
msgstr ""

#: includes/Config/BlocksList.php:92
msgid "Site Logo"
msgstr ""

#: includes/Config/BlocksList.php:93
msgid ""
"Displays the site logo with upload/replace support, optional home link, "
"responsive width, border, and shadow controls."
msgstr ""

#: includes/Config/BlocksList.php:98
msgid "Query Title"
msgstr ""

#: includes/Config/BlocksList.php:99
msgid ""
"Displays the archive, search, or post type title for the current query, "
"with prefix and search-term options."
msgstr ""

#: includes/Config/BlocksList.php:104
msgid "Archive Description"
msgstr ""

#: includes/Config/BlocksList.php:105
msgid ""
"Displays the description for the current archive such as category, tag, "
"taxonomy, or author."
msgstr ""

#: includes/Config/BlocksList.php:110
msgid "Query Total"
msgstr ""

#: includes/Config/BlocksList.php:111
msgid ""
"Displays the total number of results for the current main query, as a count "
"or range."
msgstr ""

#: includes/Config/BlocksList.php:116
msgid "Paragraph"
msgstr ""

#: includes/Config/BlocksList.php:117
msgid ""
"A standard paragraph block with advanced typography, colors, text shadow, "
"and dynamic data binding. Use for general text content."
msgstr ""

#: includes/Config/BlocksList.php:122
msgid "Image"
msgstr ""

#: includes/Config/BlocksList.php:123
msgid ""
"Displays an image with full visual control including custom dimensions, "
"object-fit, opacity, CSS filters, border, shadow, and hover transition "
"effects. Also supports captions. Use when more styling control than the "
"core image block is needed."
msgstr ""

#: includes/Config/BlocksList.php:128
msgid "Button"
msgstr ""

#: includes/Config/BlocksList.php:129
msgid ""
"A call-to-action button with a label, URL, optional icon (before or after "
"text), and full hover styling for color, background, border, and shadow. "
"Use for CTAs, download links, or any interactive link that needs custom "
"visual design."
msgstr ""

#: includes/Config/BlocksList.php:134
msgid "Video"
msgstr ""

#: includes/Config/BlocksList.php:135
msgid ""
"Embeds a video from YouTube, Vimeo, or a self-hosted file. Supports "
"autoplay, loop, lazy load, start/end time, aspect ratio, privacy mode, and "
"a custom poster image with overlay play button. Use for product demos, "
"testimonials, or media-rich sections."
msgstr ""

#: includes/Config/BlocksList.php:140
msgid "Google Map"
msgstr ""

#: includes/Config/BlocksList.php:141
msgid ""
"Embeds a Google Map for a given location with configurable zoom and height. "
"Use for contact pages, store locators, or any page that needs to display a "
"physical location."
msgstr ""

#: includes/Config/BlocksList.php:146
msgid "Icon List"
msgstr ""

#: includes/Config/BlocksList.php:147
msgid ""
"A list of icon and text pairs displayed in a column or row layout. Use for "
"feature lists, checklists, service highlights, or any bulleted content that "
"benefits from custom icons instead of plain bullets. Contains "
"icon-list-item child blocks."
msgstr ""

#: includes/Config/BlocksList.php:152
msgid "Icon List Item"
msgstr ""

#: includes/Config/BlocksList.php:153
msgid ""
"A single icon and text row inside an Icon List block. Each item has its own "
"text, icon, and optional link. Must be placed inside an Icon List block."
msgstr ""

#: includes/Config/BlocksList.php:159
msgid "Rating"
msgstr ""

#: includes/Config/BlocksList.php:160
msgid ""
"Displays a visual star (or custom icon) rating with a configurable scale "
"and decimal value. Use for product reviews, service ratings, or testimonial "
"sections."
msgstr ""

#: includes/Config/BlocksList.php:165
msgid "Counter"
msgstr ""

#: includes/Config/BlocksList.php:166
msgid ""
"An animated number that counts up to a target value on scroll. Supports a "
"prefix, suffix, thousand separator, and a title label positioned above or "
"below the number. Use for statistics sections ? e.g. \"500+ clients\", "
"\"99% uptime\", \"$2M raised\"."
msgstr ""

#: includes/Config/BlocksList.php:171
msgid "Progress Bar"
msgstr ""

#: includes/Config/BlocksList.php:172
msgid ""
"An animated horizontal bar that fills to a given percentage on scroll. "
"Supports a title, an inner text label inside the fill, and custom colors. "
"Use for skills sections, fundraising progress, or any percentage-based "
"visual indicator."
msgstr ""

#: includes/Config/BlocksList.php:177
msgid "Social Icons"
msgstr ""

#: includes/Config/BlocksList.php:178
msgid ""
"A grid of social media icon links with shape options (circle, square, "
"rounded), official brand colors or custom colors, hover animations, and "
"flexible column layout. Use in headers, footers, author bios, or contact "
"sections. Contains social-icon-item child blocks."
msgstr ""

#: includes/Config/BlocksList.php:183
msgid "Social Icon Item"
msgstr ""

#: includes/Config/BlocksList.php:184
msgid ""
"A single social network link inside a Social Icons block. Defines the "
"network (facebook, instagram, linkedin, youtube, etc.), its icon, brand "
"color, and URL. Must be placed inside a Social Icons block."
msgstr ""

#: includes/Config/BlocksList.php:190
msgid "Accordion"
msgstr ""

#: includes/Config/BlocksList.php:191
msgid ""
"A collapsible accordion that can allow one or multiple items open at once. "
"Supports FAQ structured data markup for SEO. Use for FAQs, product specs, "
"or any expandable Q&A content. Contains accordion-item child blocks."
msgstr ""

#: includes/Config/BlocksList.php:196
msgid "Accordion Item"
msgstr ""

#: includes/Config/BlocksList.php:197
msgid ""
"A single collapsible panel inside an Accordion block. Has a title, a "
"default-open option, and customizable expand/collapse icons. The content "
"area accepts any inner blocks. Must be placed inside an Accordion block."
msgstr ""

#: includes/Config/BlocksList.php:203
msgid "Tab"
msgstr ""

#: includes/Config/BlocksList.php:204
msgid ""
"A tabbed content container with horizontal or vertical tab navigation, "
"configurable active tab, and optional icons on each tab. Use for product "
"details, service categories, pricing tiers, or any multi-section content "
"that benefits from tab navigation. Contains tab-item child blocks."
msgstr ""

#: includes/Config/BlocksList.php:209
msgid "Tab Item"
msgstr ""

#: includes/Config/BlocksList.php:210
msgid ""
"A single tab panel inside a Tab block. Has a title, an optional icon, and a "
"default-active option. The content area accepts any inner blocks. Must be "
"placed inside a Tab block."
msgstr ""

#: includes/Config/BlocksList.php:216
msgid "Navigation"
msgstr ""

#: includes/Config/BlocksList.php:217
msgid ""
"A top-level responsive navigation wrapper that automatically switches "
"between a desktop navigation menu and a mobile-friendly slide-in offcanvas "
"drawer based on a breakpoint. Acts as the primary container for site "
"headers. Contains navmenu and offcanvas child blocks."
msgstr ""

#: includes/Config/BlocksList.php:222
msgid "Nav Menu"
msgstr ""

#: includes/Config/BlocksList.php:223
msgid ""
"A desktop navigation menu block that acts as the primary layout for headers "
"and footers. Supports horizontal and vertical layouts, custom item styling, "
"typography, spacing, and hover states. Must be placed inside a Navigation "
"block."
msgstr ""

#: includes/Config/BlocksList.php:229
msgid "Nav Menu Item"
msgstr ""

#: includes/Config/BlocksList.php:230
msgid ""
"A single navigation item link inside a Nav Menu block. Defines the link "
"URL, text, and active state styling. Can be nested to create dropdown "
"submenus when supported. Must be placed inside a Nav Menu block."
msgstr ""

#: includes/Config/BlocksList.php:236
msgid "Off Canvas"
msgstr ""

#: includes/Config/BlocksList.php:237
msgid ""
"A mobile slide-in drawer panel with a hamburger menu trigger. Can "
"automatically mirror the sibling Nav Menu items or have custom content. "
"Supports left/right side sliding, custom header, overlay styling, and close "
"button configurations. Must be placed inside a Navigation block."
msgstr ""

#: includes/Config/BlocksList.php:243
msgid "Before/After Slider"
msgstr ""

#: includes/Config/BlocksList.php:244
msgid ""
"An interactive slider that lets users compare two images (a \"before\" and "
