msgstr ""

#: includes/Mcp/Abilities/GetMagicLogin/Config.php:14
msgid "Get Magic Login URL"
msgstr ""

#: includes/Mcp/Abilities/GetIcons/Config.php:14
msgid "Get Icons"
msgstr ""

