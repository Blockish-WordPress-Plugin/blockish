{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "blockish/social-icons",
  "version": "1.0.0",
  "title": "Social Icons",
  "category": "blockish-framework",
  "description": "Social icon list for profile links.",
  "keywords": [
    "blockish",
    "social",
    "icons"
  ],
  "example": {
    "attributes": {
      "preview": true
    }
  },
  "attributes": {
    "shape": {
      "type": "string",
      "default": "circle"
    },
    "flexDirection": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}}": "flex-direction: {{VALUE}};"
      }
    },
    "flexWrap": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}}": "flex-wrap: {{VALUE}};"
      }
    },
    "alignment": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}}": "justify-content: {{VALUE}};"
      }
    },
    "iconColorMode": {
      "type": "string",
      "default": "official"
    },
    "iconColor": {
      "type": "string",
      "selectors": {
        ".{{WRAPPER}}": "--blockish-social-icons-primary-color: {{VALUE}};"
      }
    },
    "iconSecondaryColor": {
      "type": "string",
      "selectors": {
        ".{{WRAPPER}}": "--blockish-social-icons-secondary-color: {{VALUE}};"
      }
    },
    "iconSize": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}} .blockish-social-icon-item__icon svg": "width: {{VALUE}}; height: {{VALUE}};"
      }
    },
    "iconPadding": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}} .blockish-social-icon-item__link": "padding: {{TOP}} {{RIGHT}} {{BOTTOM}} {{LEFT}};"
      }
    },
    "iconSpacing": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}}": "column-gap: {{VALUE}};"
      }
    },
    "iconRowsGap": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}}": "row-gap: {{VALUE}};"
      }
    },
    "iconBorder": {
      "type": "string",
      "groupSelector": {
        "type": "BlockishBorder",
        "selector": ".{{WRAPPER}} .blockish-social-icon-item__link"
      }
    },
    "iconBorderRadius": {
      "type": "object",
      "selectors": {
        ".{{WRAPPER}} .blockish-social-icon-item__link": "border-radius: {{TOP_LEFT}} {{TOP_RIGHT}} {{BOTTOM_RIGHT}} {{BOTTOM_LEFT}};"
      }
    },
    "hoverAnimation": {
      "type": "string",
      "selectors": {
        ".{{WRAPPER}} .blockish-social-icon-item__link:hover": "animation-name: {{VALUE}};"
      }
    }
  },
  "supports": {
    "html": true,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "textdomain": "blockish",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "usesContext": [
    "postId",
    "postType"
  ]
}
