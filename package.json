{
	"name": "blockish",
	"version": "1.2.4",
	"description": "Example block scaffolded with Create Block tool.",
	"author": "wowdevs <hello@wowdevs.com>",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "composer run phpcs",
		"format:php": "composer run phpcbf",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"start-hot": "wp-scripts start --hot",
		"make-pot": "npx @wp-blocks/make-pot --exclude=node_modules,vendor,src",
		"publish": "composer install --no-dev --optimize-autoloader && npm run build && npm run make-pot && npm run plugin-zip && composer install"
	},
	"files": [
		"blockish.php",
		"readme.txt",
		"build",
		"includes",
		"vendor",
		"languages",
		"assets"
	],
	"devDependencies": {
		"@wordpress/scripts": "^32.5.0"
	},
	"dependencies": {
		"@wordpress/icons": "^15.0.0",
		"clsx": "^2.1.1",
		"history": "^5.3.0",
		"html-react-parser": "^5.2.10",
		"react-select": "^5.8.3",
		"react-sortablejs": "^6.1.4",
		"sortablejs": "^1.15.7"
	}
}
